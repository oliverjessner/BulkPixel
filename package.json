{
    "name": "bulkpixel",
    "private": true,
    "version": "3.2.0",
    "type": "module",
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "prepare:ui": "node scripts/sync-designsystem.mjs",
        "prepare:url-import": "node scripts/prepare-url-import.mjs",
        "prepare:app": "npm run prepare:ui && npm run prepare:url-import",
        "postinstall": "npm run prepare:ui",
        "tauri": "tauri",
        "dev": "tauri dev",
        "build": "tauri build",
        "pretest": "npm run prepare:ui",
        "test": "node --test",
        "prescreenshots": "npm run prepare:ui",
        "screenshots": "node scripts/screenshots.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "publish": "sh scripts/publish.sh"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oliverjessner/bulkpixel.git"
    },
    "bugs": {
        "url": "https://github.com/oliverjessner/bulkpixel/issues"
    },
    "homepage": "https://oliverjessner.at/bulkpixel",
    "author": {
        "name": "oliverjessner",
        "url": "https://oliverjessner.at"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4"
    },
    "dependencies": {
        "add": "^2.0.9",
        "fetchary": "2.0.7",
        "git": "^0.1.5",
        "oj-designsystem": "0.2.1"
    }
}
